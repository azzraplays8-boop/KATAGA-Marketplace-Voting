# Copy this file to .env and change the values
# The admin password protects the /admin dashboard
ADMIN_PASSWORD=change-this-password

# Supabase PostgreSQL session pooler connection string.
# Example format (use YOUR OWN values from Supabase -> Connect -> Session pooler):
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# On Render this is configured as an environment variable in the dashboard instead.
DATABASE_URL=

PORT=3000
